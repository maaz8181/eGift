@using eGift.Admin.Helpers
@model EmployeeListViewModel

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Employees</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Employee
        </a>

    </div>

    @if (Model != null && Model.EmployeeList != null && Model.EmployeeList.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Active</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int count = 1;
                    }

                    @foreach (var employee in Model.EmployeeList)
                    {
                        <tr>

                            <td>
                                @count
                            </td>

                            <td>
                                @employee.FirstName
                            </td>

                            <td>
                                @employee.LastName
                            </td>

                            <td>
                                @employee.Mobile
                            </td>

                            <td>
                                @(employee.Email ?? "-")
                            </td>

                            <td>
                                @employee.DateofBirth.ToDateString()
                            </td>

                            <td>
                                @employee.GenderName
                            </td>

                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                @employee.CreatedDate.ToDateString()
                            </td>

                            <td>
                                <div class="d-flex gap-1">

                                    <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-warning btn-sm">
                                        Edit
                                    </a>
                                    @if (!employee.IsDefault)
                                    {
                                        <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this employee?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Delete
                                            </button>

                                        </form>
                                    }
                                </div>
                            </td>

                        </tr>

                        count++;
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No employees found.
        </div>
    }

</div>